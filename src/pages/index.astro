---
import { getCollection } from "astro:content";
import NewsCards from "../components/NewsCards.astro";
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
import { site } from "../site";

const news = (await getCollection("news")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<Base wide>
  <section class="hero">
    <h1>Wir schaffen einen Ort, an dem Ideen gebaut werden.</h1>
    <p>{site.tagline}</p>
    <a class="button" href={url("/veranstaltungen/")}>Schau vorbei!</a>
    <a class="button outline" href={url("/mitmachen/")}>Mitmachen!</a>
  </section>
  <h2>Aktuelles aus der Community</h2>
  <NewsCards news={news} />
  <p><a class="button" href={url("/geschichten/")}>Alle News anzeigen</a></p>
</Base>
