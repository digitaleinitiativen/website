---
import { getCollection, render } from "astro:content";
import { url } from "../../lib/url";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  return (await getCollection("news")).map((n) => ({ params: { slug: n.id }, props: { n } }));
}
const { n } = Astro.props;
const { Content } = await render(n);
---
<Base title={n.data.title} description={n.data.description} source={n.filePath}>
  <p class="muted">{n.data.date.toLocaleDateString("de-AT", { dateStyle: "long" })}</p>
  <h1 class="page-title">{n.data.title}</h1>
  {n.data.image && <img src={url(n.data.image)} alt="" />}
  <Content />
</Base>
