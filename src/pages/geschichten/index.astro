---
import { getCollection } from "astro:content";
import NewsCards from "../../components/NewsCards.astro";
import Base from "../../layouts/Base.astro";
import { url } from "../../lib/url";

const news = (await getCollection("news")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="What's up?" wide>
  <h1 class="page-title">What's up?</h1>
  <p style="text-align:center">Geschichten aus der Community. <a href={url("/geschichten/rss.xml")}>RSS-Feed</a></p>
  <NewsCards news={news} />
</Base>
